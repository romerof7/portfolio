---
import SectionHeading from './SectionHeading.astro';
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = profile[lang];

// Iniciales para el avatar cuando todavía no hay foto
const initials = profile.name
	.split(' ')
	.map((word) => word[0])
	.slice(0, 2)
	.join('');
---

<section id="sobre-mi" class="scroll-mt-20 py-16">
	<SectionHeading lang={lang} title={t('about.title')} />

	<div class="mt-8 flex flex-col gap-8 sm:flex-row sm:items-start">
		{profile.photo ? (
			<img
				src={profile.photo}
				alt={t('about.photoAlt')}
				width="160"
				height="160"
				loading="lazy"
				class="h-40 w-40 shrink-0 rounded-2xl object-cover"
			/>
		) : (
			<div
				aria-hidden="true"
				class="flex h-40 w-40 shrink-0 items-center justify-center rounded-2xl bg-slate-200 text-4xl font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400"
			>
				{initials}
			</div>
		)}

		<div class="space-y-4 text-slate-600 dark:text-slate-400">
			{data.about.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</div>
	</div>

	<h3 class="mt-12 text-lg font-semibold">{t('stack.title')}</h3>
	<div class="mt-4 grid gap-6 sm:grid-cols-2">
		{data.stack.map((group) => (
			<div>
				<h4 class="text-sm font-medium text-slate-500">{group.title}</h4>
				<ul class="mt-2 flex flex-wrap gap-2">
					{group.items.map((item) => (
						<li class="rounded-md bg-slate-100 px-2.5 py-1 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-300">
							{item}
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</section>
