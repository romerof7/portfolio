---
import SkeletonImage from './SkeletonImage.astro';
import SectionHeading from './SectionHeading.astro';
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = profile[lang];
const facts = data.facts;
const stack = data.stack.filter((group) => group.items.length > 0);

// Initials for the avatar when there is no photo yet
const initials = profile.name
	.split(' ')
	.map((word) => word[0])
	.slice(0, 2)
	.join('');
---

<section id="about" class="scroll-mt-20 py-16">
	<SectionHeading lang={lang} title={t('about.title')} />

	<div class="mt-8 flex flex-col gap-8 sm:flex-row sm:items-start">
		{profile.photo ? (
			<SkeletonImage
				src={profile.photo}
				alt={t('about.photoAlt')}
				width={320}
				height={320}
				fit="cover"
				format="webp"
				loading="lazy"
				wrapperClass="h-40 w-40 shrink-0 rounded-full"
				class="h-full w-full object-cover"
			/>
		) : (
			<div
				aria-hidden="true"
				class="flex h-40 w-40 shrink-0 items-center justify-center rounded-full bg-slate-200 text-4xl font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400"
			>
				{initials}
			</div>
		)}

		<div class="space-y-4 text-slate-600 dark:text-slate-400">
			{data.about.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</div>
	</div>

	{facts.length > 0 && (
		<dl class="mt-10 grid gap-x-8 gap-y-4 rounded-2xl border border-slate-200 p-5 sm:grid-cols-2 dark:border-slate-800">
			{facts.map((fact) => (
				<div>
					<dt class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
						{fact.label}
					</dt>
					<dd class="mt-1 text-sm text-slate-700 dark:text-slate-300">
						{fact.href ? (
							<a
								href={fact.href}
								target="_blank"
								rel="noopener noreferrer"
								class="underline underline-offset-4 hover:text-slate-900 dark:hover:text-white"
							>
								{fact.value} ↗︎
							</a>
						) : (
							fact.value
						)}
					</dd>
				</div>
			))}
		</dl>
	)}

	{stack.length > 0 && (
		<>
			<h3 class="mt-12 text-lg font-semibold">{t('stack.title')}</h3>
			<div class="mt-4 grid gap-6 sm:grid-cols-2">
				{stack.map((group) => (
					<div>
						<h4 class="text-sm font-medium text-slate-500">{group.title}</h4>
						<ul class="mt-2 flex flex-wrap gap-2">
							{group.items.map((item) => (
								<li class="rounded-md bg-slate-100 px-2.5 py-1 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-300">
									{item}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</>
	)}
</section>
