---
import { languages, useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
	lang: Lang;
	/** Path of this page without the language, e.g. "projects/my-project/". Empty = home. */
	altPath?: string;
}

const { lang, altPath = '' } = Astro.props;
const t = useTranslations(lang);

// Anchors include the language so they also work from other pages
const links = [
	{ href: `/${lang}/#about`, label: t('nav.about') },
	...(profile[lang].timeline.length > 0
		? [{ href: `/${lang}/#experience`, label: t('nav.experience') }]
		: []),
	{ href: `/${lang}/#projects`, label: t('nav.projects') },
	{ href: `/${lang}/#contact`, label: t('nav.contact') },
];

// Link to this same page in the other language
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

// CV download button, shown only when the PDF exists for this language
const cv = profile.cv[lang];
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
	<nav
		class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-2 px-4 py-3 sm:gap-4 sm:px-6"
		aria-label={t('nav.label')}
	>
		<a href={`/${lang}/`} class="font-semibold tracking-tight">
			FR
		</a>

		<ul class="flex items-center gap-x-2 text-sm sm:gap-x-4">
			{links.map((link) => (
				<li class="hidden sm:block">
					<a
						href={link.href}
						data-nav-link
						class="text-slate-600 transition-colors hover:text-slate-900 aria-[current=true]:font-medium aria-[current=true]:text-sky-600 dark:text-slate-400 dark:hover:text-white dark:aria-[current=true]:text-sky-400"
					>
						{link.label}
					</a>
				</li>
			))}
			<li>
				<!-- Shows the flag and name of the language you can switch to -->
				<a
					href={`/${otherLang}/${altPath}`}
					hreflang={otherLang}
					lang={otherLang}
					class="flex items-center gap-1.5 rounded-md border border-slate-300 px-2 py-1.5 text-xs font-medium transition-colors hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
					title={t('lang.switch')}
					aria-label={`${t('lang.switch')}: ${languages[otherLang]}`}
				>
					<!-- Flag of the language you switch to (SVG, because emoji flags show as letters on Windows) -->
					{otherLang === 'es' ? (
						<svg class="h-3.5 w-5 shrink-0 rounded-[3px]" viewBox="0 0 20 14" aria-hidden="true">
							<rect width="20" height="14" fill="#74acdf" />
							<rect y="4.67" width="20" height="4.67" fill="#fff" />
							<circle cx="10" cy="7" r="1.4" fill="#f6b40e" />
						</svg>
					) : (
						<svg class="h-3.5 w-5 shrink-0 rounded-[3px]" viewBox="0 0 20 14" aria-hidden="true">
							<rect width="20" height="14" fill="#fff" />
							<path d="M0 1h20M0 5h20M0 9h20M0 13h20" stroke="#b22234" stroke-width="2" />
							<rect width="9" height="8" fill="#3c3b6e" />
						</svg>
					)}
					{languages[otherLang]}
				</a>
			</li>
			{cv && (
				<li class="hidden sm:block">
					<a
						href={cv}
						download
						class="rounded-md bg-slate-900 px-2.5 py-1 text-xs font-medium text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
					>
						{t('cv.download')}
					</a>
				</li>
			)}
			<li>
				<button
					id="theme-toggle"
					type="button"
					class="rounded-md border border-slate-300 px-2 py-1.5 text-xs transition-colors hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
					aria-label={t('theme.toggle')}
				>
					<span class="dark:hidden">
						🌙<span class="hidden sm:inline"> {t('theme.dark')}</span>
					</span>
					<span class="hidden dark:inline">
						☀️<span class="hidden sm:inline"> {t('theme.light')}</span>
					</span>
				</button>
			</li>
			<li class="sm:hidden">
				<!-- Three-line button (phones only): opens the menu below -->
				<button
					id="menu-toggle"
					type="button"
					class="group rounded-md border border-slate-300 px-2 py-1.5 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
					aria-label={t('nav.menu')}
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<svg
						class="h-4 w-4"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path class="group-aria-expanded:hidden" d="M4 6h16M4 12h16M4 18h16" />
						<path class="hidden group-aria-expanded:block" d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>
			</li>
		</ul>

		<!-- Phone menu: same links, bigger tap targets, and the CV button -->
		<div
			id="mobile-menu"
			hidden
			class="basis-full border-t border-slate-200 pt-1 sm:hidden dark:border-slate-800"
		>
			<ul>
				{links.map((link) => (
					<li>
						<a
							href={link.href}
							data-nav-link
							class="block rounded-md px-2 py-3 text-base text-slate-700 transition-colors hover:bg-slate-100 aria-[current=true]:font-medium aria-[current=true]:text-sky-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:aria-[current=true]:text-sky-400"
						>
							{link.label}
						</a>
					</li>
				))}
				{cv && (
					<li class="pt-1 pb-1">
						<a
							href={cv}
							download
							class="block rounded-md bg-slate-900 px-3 py-3 text-center text-base font-medium text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
						>
							{t('cv.download')}
						</a>
					</li>
				)}
			</ul>
		</div>
	</nav>
</header>

<script>
	const button = document.getElementById('theme-toggle');

	button?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		} catch {
			// If the browser blocks localStorage, the theme still changes for this visit
		}
	});

	// Highlights the nav link of the section you are reading (home page only)
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]');
	const sections = [...navLinks]
		.filter((link) => link.pathname === location.pathname && link.hash)
		.map((link) => document.querySelector<HTMLElement>(link.hash))
		.filter((section): section is HTMLElement => section !== null);

	if (sections.length > 0 && 'IntersectionObserver' in window) {
		const setActive = (id: string | null) => {
			navLinks.forEach((link) => {
				if (id !== null && link.hash === `#${id}`) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		// A thin band across the upper-middle of the screen: the section crossing it is "current"
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) setActive(entry.target.id);
				}
			},
			{ rootMargin: '-40% 0px -55% 0px' },
		);
		sections.forEach((section) => observer.observe(section));

		// The hero is not in the menu: back at the top, nothing is highlighted
		const hero = document.getElementById('home');
		if (hero) {
			new IntersectionObserver(
				(entries) => {
					if (entries.some((entry) => entry.isIntersecting)) setActive(null);
				},
				{ rootMargin: '-40% 0px -55% 0px' },
			).observe(hero);
		}

		// The last section can be too short to reach the band: at the very bottom it is the current one
		window.addEventListener(
			'scroll',
			() => {
				const atBottom =
					window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
				if (atBottom) setActive(sections[sections.length - 1].id);
			},
			{ passive: true },
		);
	}

	// Phone menu (three-line button)
	const menuButton = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	function setMenu(open: boolean) {
		if (!menuButton || !menu) return;
		menu.hidden = !open;
		menuButton.setAttribute('aria-expanded', String(open));
	}

	menuButton?.addEventListener('click', () => {
		setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
	});

	// Close after choosing a link, with Escape, or when tapping outside
	menu?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('a')) setMenu(false);
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
			setMenu(false);
			menuButton.focus();
		}
	});
	document.addEventListener('click', (event) => {
		const target = event.target as Node;
		if (!menu?.contains(target) && !menuButton?.contains(target)) setMenu(false);
	});
</script>
