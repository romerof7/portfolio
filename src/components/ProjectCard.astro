---
import { formatDate, projectSlug, type Project } from '../lib/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	project: Project;
	lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { title, description, tech, date, repo, demo, placeholder } = project.data;
const href = `/${lang}/projects/${projectSlug(project)}/`;
---

<article
	class="flex flex-col rounded-xl border border-slate-200 p-5 transition-colors hover:border-slate-400 dark:border-slate-800 dark:hover:border-slate-600"
>
	<div class="flex items-start justify-between gap-3">
		<h3 class="text-lg font-semibold">
			<a href={href} class="hover:underline">{title}</a>
		</h3>
		{
			placeholder && (
				<span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
					{t('projects.placeholder')}
				</span>
			)
		}
	</div>

	<time
		datetime={date.toISOString()}
		class="mt-1 text-xs text-slate-500 first-letter:uppercase dark:text-slate-500"
	>
		{formatDate(date, lang)}
	</time>

	<p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{description}</p>

	<ul class="mt-4 flex flex-wrap gap-2">
		{
			tech.map((name) => (
				<li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">
					{name}
				</li>
			))
		}
	</ul>

	<div class="mt-5 flex flex-wrap items-center gap-4 text-sm">
		<a href={href} class="font-medium underline-offset-4 hover:underline">
			{t('projects.viewDetail')}
		</a>
		{
			repo && (
				<a
					href={repo}
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 underline-offset-4 hover:underline dark:text-slate-400"
				>
					{t('projects.repo')} ↗
				</a>
			)
		}
		{
			demo && (
				<a
					href={demo}
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 underline-offset-4 hover:underline dark:text-slate-400"
				>
					{t('projects.demo')} ↗
				</a>
			)
		}
	</div>
</article>
