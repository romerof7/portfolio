---
import SkeletonImage from './SkeletonImage.astro';
import { formatDate, projectSlug, type Project } from '../lib/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	project: Project;
	lang: Lang;
	/** Nivel del título según dónde se use la tarjeta (h2 si la página tiene h1, h3 bajo un h2). */
	headingLevel?: 'h2' | 'h3';
}

const { project, lang, headingLevel: Heading = 'h3' } = Astro.props;
const t = useTranslations(lang);
const { title, description, tech, date, repo, demo, image, placeholder } = project.data;
const href = `/${lang}/projects/${projectSlug(project)}/`;
---

<article class="flex flex-col overflow-hidden rounded-xl border border-slate-200 transition-colors hover:border-slate-400 dark:border-slate-800 dark:hover:border-slate-600">
	{image && (
		<a href={href} tabindex="-1" aria-hidden="true" class="block">
			<SkeletonImage
				src={image}
				alt=""
				width={720}
				height={405}
				fit="cover"
				format="webp"
				loading="lazy"
				wrapperClass="aspect-video w-full"
				class="h-full w-full object-cover"
			/>
		</a>
	)}

	<div class="flex flex-1 flex-col p-5">
		<div class="flex items-start justify-between gap-3">
			<Heading class="text-lg font-semibold">
				<a href={href} class="hover:underline">
					{title}
				</a>
			</Heading>
			{placeholder && (
				<span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
					{t('projects.placeholder')}
				</span>
			)}
		</div>

		<time
			datetime={date.toISOString()}
			class="mt-1 text-xs text-slate-500 first-letter:uppercase dark:text-slate-500"
		>
			{formatDate(date, lang)}
		</time>

		<p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{description}</p>

		<ul class="mt-4 flex flex-wrap gap-2">
			{tech.map((name) => (
				<li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">
					{name}
				</li>
			))}
		</ul>

		<div class="mt-auto flex flex-wrap items-center gap-4 pt-5 text-sm">
			<a href={href} class="font-medium underline-offset-4 hover:underline">
				{t('projects.viewDetail')}
			</a>
			{repo && (
				<a
					href={repo}
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 underline-offset-4 hover:underline dark:text-slate-400"
				>
					{t('projects.repo')} ↗
				</a>
			)}
			{demo && (
				<a
					href={demo}
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 underline-offset-4 hover:underline dark:text-slate-400"
				>
					{t('projects.demo')} ↗
				</a>
			)}
		</div>
	</div>
</article>
