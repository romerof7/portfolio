---
import SkeletonImage from './SkeletonImage.astro';
import { projectSlug, type Project } from '../lib/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	project: Project;
	lang: Lang;
	/** Heading level depending on where the card is used (h2 if the page has an h1, h3 under an h2). */
	headingLevel?: 'h2' | 'h3';
	/** Wide card (spans both columns, image on the left): for the main project. */
	wide?: boolean;
}

const { project, lang, headingLevel: Heading = 'h3', wide = false } = Astro.props;
const t = useTranslations(lang);
const { title, description, tech, date, repo, demo, image, kind, placeholder } = project.data;
const href = `/${lang}/projects/${projectSlug(project)}/`;

const MAX_TECH = 4;
const shownTech = tech.slice(0, MAX_TECH);
const extraTech = tech.length - shownTech.length;

const linkClass =
	'relative z-10 rounded-md px-1 text-slate-600 underline-offset-4 hover:text-slate-900 hover:underline dark:text-slate-400 dark:hover:text-white';
---

<article
	class:list={[
		'group relative flex h-full overflow-hidden rounded-2xl border border-slate-200 bg-white/60 shadow-sm transition duration-300',
		'hover:-translate-y-0.5 hover:border-sky-400/60 hover:shadow-lg hover:shadow-sky-500/10',
		'dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-sky-400/50',
		'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
		wide ? 'flex-col sm:flex-row' : 'flex-col',
	]}
>
	{image && (
		<div class:list={['shrink-0 overflow-hidden', wide ? 'bg-[#09132a] sm:w-[55%]' : '']}>
			<SkeletonImage
				src={image}
				alt=""
				width={wide ? 900 : 720}
				height={wide ? 560 : 405}
				fit="cover"
				format="webp"
				loading="lazy"
				wrapperClass={wide ? 'aspect-video w-full sm:aspect-auto sm:h-full' : 'aspect-video w-full'}
				class:list={[
					'h-full w-full object-cover transition duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100',
					wide && 'sm:object-contain',
				]}
			/>
		</div>
	)}

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<p class="flex flex-wrap items-center gap-x-2 text-[0.7rem] font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
			{kind && <span>{kind}</span>}
			{kind && (
				<span aria-hidden="true" class="text-slate-400 dark:text-slate-600">
					·
				</span>
			)}
			<time datetime={date.toISOString()} class="text-slate-500 dark:text-slate-500">
				{date.getUTCFullYear()}
			</time>
			{placeholder && (
				<span class="rounded-full bg-amber-100 px-2 py-0.5 normal-case tracking-normal text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
					{t('projects.placeholder')}
				</span>
			)}
		</p>

		<Heading
			class={
				wide
					? 'mt-2 text-xl font-bold tracking-tight sm:text-2xl'
					: 'mt-2 text-lg font-semibold leading-snug'
			}
		>
			<a
				href={href}
				class="after:absolute after:inset-0 after:content-[''] hover:underline hover:underline-offset-4"
			>
				{title}
			</a>
		</Heading>

		<p class="mt-2 line-clamp-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
			{description}
		</p>

		<ul class="mt-4 flex flex-wrap gap-1.5">
			{shownTech.map((name) => (
				<li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">
					{name}
				</li>
			))}
			{extraTech > 0 && (
				<li class="rounded-md px-1.5 py-0.5 text-xs text-slate-500 dark:text-slate-500">
					+{extraTech}
				</li>
			)}
		</ul>

		<div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-5 text-sm">
			<span class="font-medium text-sky-600 dark:text-sky-400">
				{t('projects.viewDetail')}{' '}
				<span
					aria-hidden="true"
					class="inline-block transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
				>
					→
				</span>
			</span>
			{repo && (
				<a href={repo} target="_blank" rel="noopener noreferrer" class={linkClass}>
					{t('projects.repo')} ↗︎
				</a>
			)}
			{demo && (
				<a href={demo} target="_blank" rel="noopener noreferrer" class={linkClass}>
					{t('projects.demo')} ↗︎
				</a>
			)}
		</div>
	</div>
</article>
