---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Experience from '../../components/Experience.astro';
import Contact from '../../components/Contact.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { getProjects } from '../../lib/projects';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const featured = (await getProjects(lang)).filter((p) => p.data.featured).slice(0, 3);
---

<Layout lang={lang}>
	<main id="main" class="mx-auto max-w-3xl px-6">
		<Hero lang={lang} />
		<About lang={lang} />
		<Experience lang={lang} />

		<section id="projects" class="scroll-mt-20 py-16">
			<!-- Cada proyecto de ejemplo ya lleva su propia etiqueta -->
			<SectionHeading lang={lang} title={t('projects.featured')} showPlaceholder={false} />

			{featured.length > 0 ? (
				<div class="mt-6 grid gap-5 sm:grid-cols-2">
					{featured.map((project, index) => (
						<ProjectCard project={project} lang={lang} wide={index === 0} />
					))}
				</div>
			) : (
				<p class="mt-4 text-slate-600 dark:text-slate-400">{t('projects.empty')}</p>
			)}

			<a
				href={`/${lang}/projects/`}
				class="mt-8 inline-block text-sm font-medium underline-offset-4 hover:underline"
			>
				{t('projects.viewAll')} →
			</a>
		</section>

		<Contact lang={lang} />
	</main>
</Layout>
