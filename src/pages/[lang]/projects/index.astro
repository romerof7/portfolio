---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';
import { getProjects } from '../../../lib/projects';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<Layout lang={lang} altPath="projects/" title={`${t('projects.title')} | Francisco Romero`}>
	<main id="main" class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="text-3xl font-bold tracking-tight">{t('projects.title')}</h1>

		{projects.length > 0 ? (
			<div class="mt-8 grid gap-5 sm:grid-cols-2">
				{projects.map((project, index) => (
					// Wrapper so the reveal doesn't clash with the card's own hover effect
					<div data-reveal style={`--reveal-delay: ${(index % 2) * 120}ms`}>
						<ProjectCard project={project} lang={lang} headingLevel="h2" />
					</div>
				))}
			</div>
		) : (
			<p class="mt-6 text-slate-600 dark:text-slate-400">{t('projects.empty')}</p>
		)}
	</main>
</Layout>
