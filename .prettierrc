{
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 100,
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": { "parser": "astro" }
		},
		{
			"files": "*.md",
			"options": { "useTabs": false, "proseWrap": "preserve" }
		},
		{
			"files": ["*.json", "*.yml", "*.yaml"],
			"options": { "useTabs": false }
		}
	]
}
